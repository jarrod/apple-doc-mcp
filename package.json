{
  "name": "apple-doc-mcp-server",
  "version": "2.0.0",
  "description": "MCP server providing seamless access to Apple Developer Documentation with smart search and wildcard support",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "apple-doc-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "LICENSE",
    ".xo-config.js",
    "bun.lockb",
    "bunfig.toml",
    "tsconfig.json"
  ],
  "keywords": [
    "mcp",
    "apple",
    "documentation",
    "ios",
    "macos",
    "swiftui",
    "uikit"
  ],
  "author": "MightyDillah",
  "repository": {
    "type": "git",
    "url": "https://github.com/jarrod/apple-doc-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jarrod/apple-doc-mcp/issues"
  },
  "homepage": "https://github.com/jarrod/apple-doc-mcp#readme",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "compile": "bun build ./src/index.ts --compile --outfile ./dist/apple-doc-mcp-server",
    "lint": "xo src",
    "lint:fix": "xo src --fix",
    "start": "bun dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.2",
    "axios": "^1.12.2"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "bun-types": "latest",
    "xo": "^1.2.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
